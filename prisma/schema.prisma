generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TraceStatus {
  SUCCESS
  ERROR
  TIMEOUT
}

enum EvaluationStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED
}

enum ModelCatalogSource {
  MANUAL
  PROVIDER_DOCS
  PROVIDER_API
}

enum ModelLifecycleStatus {
  ACTIVE
  RETIRING
  DEPRECATED
  RETIRED
}

enum TaskRiskLevel {
  LOW
  MEDIUM
  HIGH
}

enum OptimizationGoal {
  BALANCED
  REDUCE_COST
  REDUCE_LATENCY
  MAXIMIZE_QUALITY
}

enum ShadowExperimentStatus {
  QUEUED
  RUNNING
  PASSED
  FAILED
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String?
  passwordHash String
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  projects     Project[]
}

model Project {
  id           String        @id @default(cuid())
  name         String
  slug         String
  description  String?
  ownerId      String
  owner        User          @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  apiKeys      ApiKey[]
  traces       Trace[]
  taskProfiles         TaskProfile[]
  shadowExperiments    ShadowExperiment[]
  providerCredentials  ProjectProviderCredential[]
  createdAt            DateTime                    @default(now())
  updatedAt            DateTime                    @updatedAt

  @@unique([ownerId, slug])
  @@index([ownerId])
}

model ProjectProviderCredential {
  id              String   @id @default(cuid())
  projectId       String
  project         Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  provider        String
  apiKeyCiphertext String
  keyHint         String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([projectId, provider])
  @@index([projectId])
}

model ModelCatalog {
  id                    String               @id @default(cuid())
  provider              String
  model                 String
  displayName           String
  status                ModelLifecycleStatus @default(ACTIVE)
  replacementProvider   String?
  replacementModel      String?
  retirementDate        DateTime?
  inputTokenPricePer1M  Decimal              @db.Decimal(12, 6)
  outputTokenPricePer1M Decimal              @db.Decimal(12, 6)
  contextWindow         Int?
  capabilities          String[]
  notes                 String?
  source                ModelCatalogSource   @default(MANUAL)
  sourceUrl             String?
  confidence            Float                @default(0.9)
  lastCheckedAt         DateTime             @default(now())
  catalogUpdatedAt      DateTime             @default(now())
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt

  @@unique([provider, model])
  @@index([status])
}

model TaskProfile {
  id               String           @id @default(cuid())
  projectId        String
  project          Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  taskName         String
  riskLevel        TaskRiskLevel    @default(MEDIUM)
  qualityThreshold Float            @default(0.8)
  optimizationGoal OptimizationGoal @default(BALANCED)
  notes            String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@unique([projectId, taskName])
  @@index([projectId, riskLevel])
}

model ApiKey {
  id         String    @id @default(cuid())
  name       String
  keyPrefix  String
  keyHash    String    @unique
  projectId  String
  project    Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  lastUsedAt DateTime?
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  @@index([projectId])
  @@index([keyPrefix])
}

model Trace {
  id               String       @id @default(cuid())
  externalId       String?
  projectId        String
  project          Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name             String
  provider         String
  model            String
  prompt           String
  response         String?
  status           TraceStatus  @default(SUCCESS)
  latencyMs        Int
  promptTokens     Int          @default(0)
  completionTokens Int          @default(0)
  totalTokens      Int          @default(0)
  costUsd          Decimal      @db.Decimal(12, 6)
  metadata         Json?
  startedAt        DateTime
  endedAt          DateTime?
  createdAt        DateTime     @default(now())
  evaluations      Evaluation[]

  @@index([projectId, createdAt])
  @@index([externalId])
  @@index([provider, model])
}

model Evaluation {
  id        String            @id @default(cuid())
  traceId   String
  trace     Trace             @relation(fields: [traceId], references: [id], onDelete: Cascade)
  status    EvaluationStatus  @default(QUEUED)
  reason    String?
  scores    EvaluationScore[]
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  @@index([traceId])
  @@index([status])
}

model EvaluationScore {
  id           String     @id @default(cuid())
  evaluationId String
  evaluation   Evaluation @relation(fields: [evaluationId], references: [id], onDelete: Cascade)
  metric       String
  score        Float
  details      Json?
  createdAt    DateTime   @default(now())

  @@unique([evaluationId, metric])
}

model ShadowExperiment {
  id                            String                 @id @default(cuid())
  projectId                     String
  project                       Project                @relation(fields: [projectId], references: [id], onDelete: Cascade)
  taskName                      String
  baselineProvider              String
  baselineModel                 String
  candidateProvider             String
  candidateModel                String
  status                        ShadowExperimentStatus @default(QUEUED)
  sampleSize                    Int                    @default(10)
  qualityThreshold              Float                  @default(0.8)
  passedRuns                    Int                    @default(0)
  failedRuns                    Int                    @default(0)
  averageCandidateSemantic      Float?
  averageCandidateHallucination Float?
  estimatedSavingsPercent       Float?
  reason                        String?
  completedAt                   DateTime?
  createdAt                     DateTime               @default(now())
  updatedAt                     DateTime               @updatedAt
  runs                          ShadowExperimentRun[]

  @@unique([projectId, taskName, baselineProvider, baselineModel, candidateProvider, candidateModel])
  @@index([projectId, status])
}

model ShadowExperimentRun {
  id                 String           @id @default(cuid())
  experimentId       String
  experiment         ShadowExperiment @relation(fields: [experimentId], references: [id], onDelete: Cascade)
  traceId            String
  baselineResponse   String
  candidateResponse  String
  semanticScore      Float
  hallucinationScore Float
  passed             Boolean
  createdAt          DateTime         @default(now())

  @@index([experimentId])
}
