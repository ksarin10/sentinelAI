DATABASE_URL="postgresql://sentinel:sentinel@localhost:5433/sentinelai?schema=public"
REDIS_URL="redis://localhost:6379"
JWT_SECRET="change-me-in-production"
NEXT_PUBLIC_API_URL="http://localhost:4000"
# Optional overrides (catalog is enabled automatically when NODE_ENV=development).
# Set to "false" to hide catalog during local next dev. Set to "true" to expose in production.
# NEXT_PUBLIC_ENABLE_MODEL_CATALOG="true"
# ENABLE_PUBLIC_MODEL_CATALOG="true"
API_PORT="4000"
OPENAI_API_KEY=""
SENTINELAI_API_KEY=""
# Use "simulate" for local shadow verification without provider API calls. Use "api" in production.
SHADOW_REPLAY_MODE="simulate"
