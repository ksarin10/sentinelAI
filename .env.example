DATABASE_URL="postgresql://sentinel:sentinel@localhost:5433/sentinelai?schema=public"
REDIS_URL="redis://localhost:6379"
JWT_SECRET="change-me-in-production"
NEXT_PUBLIC_API_URL="http://localhost:4000"
# Optional overrides (catalog is enabled automatically when NODE_ENV=development).
# Set to "false" to hide catalog during local next dev. Set to "true" to expose in production.
# NEXT_PUBLIC_ENABLE_MODEL_CATALOG="true"
# ENABLE_PUBLIC_MODEL_CATALOG="true"
API_PORT="4000"
CORS_ORIGINS="http://localhost:3000"
RUN_CATALOG_SYNC_ON_START="true"
OPENAI_API_KEY=""
# Set EVAL_JUDGE_ENABLED=true to score traces with an LLM judge (Tier A + B metrics).
EVAL_JUDGE_ENABLED="false"
EVAL_JUDGE_MODEL="gpt-4.1-mini"
ANTHROPIC_API_KEY=""
GROQ_API_KEY=""
# Encrypts per-project LLM provider keys (falls back to JWT_SECRET).
PROVIDER_CREDENTIALS_SECRET=""
SENTINELAI_API_KEY=""
# Use "simulate" for local shadow verification without provider API calls. Use "api" in production.
SHADOW_REPLAY_MODE="simulate"
SHADOW_MIN_SAVINGS_USD="1"
SHADOW_EARLY_STOP_FAILURES="5"
